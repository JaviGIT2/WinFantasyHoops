{
  "name": "win-fantasy-hoops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Expected-victory engine for Yahoo-style H2H category fantasy basketball.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run && node scripts/py.mjs -m pytest pipeline/tests -q",
    "setup:py": "node scripts/py.mjs setup",
    "data:fetch": "node scripts/py.mjs -m pipeline.fetch",
    "data:build": "node scripts/py.mjs -m pipeline.build",
    "data": "npm run data:fetch && npm run data:build",
    "icons": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
