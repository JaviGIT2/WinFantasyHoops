# Accounts (optional). Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API (the project URL, and the publishable key; the legacy "anon" key also works).
# Both are safe to ship in the app: row-level security (supabase/schema.sql) keeps each user's leagues private.
# Leave them empty to run without accounts, with leagues saved on each device.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
